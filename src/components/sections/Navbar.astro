---
// src/components/sections/Navbar.astro
import { Image } from 'astro:assets';
import logoImg from '../../assets/logo.png'; 

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/metodo-montessori', label: 'Método Montessori' },
  { href: '/casa-de-los-ninos', label: 'Casa de los Niños' },
  { href: '/rutina-diaria', label: 'Un día en Villa Montessori' },
  { href: '/galeria', label: 'Galería' },
];
---

<nav class="site-header">
  <div class="container header-container">
    
    <a href="/" class="brand-logo group">
      <div class="logo-container">
        <Image 
          src={logoImg} 
          alt="Logotipo Oficial de Centro de Educación Villa Montessori" 
          width={120}
          height={120}
          loading="eager"
          class="nav-logo"
        />
      </div>
      <div class="brand-text">
        <span class="brand-title">
          Villa Montessori
        </span>
        <span class="brand-subtitle">
          Casa de los Niños
        </span>
      </div>
    </a>

    <nav class="desktop-nav">
      {navItems.map((item) => (
        <a href={item.href} class="nav-link">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="desktop-cta">
      <a href="/contacto" class="btn btn-primary btn-round">
        Agendar Visita
      </a>
    </div>

    <button 
      id="menu-toggle" 
      class="menu-toggle-btn"
      aria-label="Abrir menú de navegación"
      aria-expanded="false"
    >
      <span class="burger-bar bar-1"></span>
      <span class="burger-bar bar-2"></span>
      <span class="burger-bar bar-3"></span>
    </button>

  </div>

  <div id="mobile-menu" class="mobile-menu-panel">
    {navItems.map((item) => (
      <a href={item.href} class="mobile-link">
        {item.label}
      </a>
    ))}
    <a href="#admisiones" class="mobile-link mobile-cta btn btn-primary">
      Agendar Visita
    </a>
  </div>
</nav>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = document.querySelectorAll('.mobile-link');

  function toggleMenu() {
    const isExpanded = menuToggle?.getAttribute('aria-expanded') === 'true';
    const newExpandedState = !isExpanded;
    
    menuToggle?.setAttribute('aria-expanded', newExpandedState.toString());
    menuToggle?.classList.toggle('is-active');
    mobileMenu?.classList.toggle('is-open');
  }

  menuToggle?.addEventListener('click', toggleMenu);
  
  mobileLinks.forEach(link => link.addEventListener('click', () => {
    if (mobileMenu?.classList.contains('is-open')) toggleMenu();
  }));
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-b: 1px solid rgba(156, 163, 175, 0.12);
    transition: background-color var(--transition-normal);
  }

  .header-container {
    height: 5.5rem; 
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
  }

  .logo-container {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-logo {
    width: auto;
    height: 3.25rem; 
    max-height: 52px;
    object-fit: contain;
    transition: transform var(--transition-fast);
  }

  .brand-logo:hover .nav-logo {
    transform: scale(1.03);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-family: var(--font-headers);
    font-size: var(--font-size-md);
    font-weight: var(--weight-bold);
    letter-spacing: -0.025em;
    color: var(--color-slate-dark);
    line-height: 1.2;
    transition: color var(--transition-fast);
  }

  .brand-logo:hover .brand-title {
    color: var(--color-brand-green-hover);
  }

  .brand-subtitle {
    font-family: var(--font-headers);
    font-size: 10px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.1em;
    color: var(--color-brand-orange);
    text-transform: uppercase;
    line-height: 1;
    margin-top: 2px;
  }

  .desktop-nav {
    display: none;
    align-items: center;
    gap: var(--space-8);
  }

  .nav-link {
    font-family: var(--font-headers);
    font-size: var(--font-size-sm);
    font-weight: var(--weight-medium);
    color: var(--color-slate-dark);
    text-decoration: none;
    transition: color var(--transition-fast);
    position: relative;
  }

  .nav-link:hover {
    color: var(--color-brand-green);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 2px;
    background-color: var(--color-brand-green);
    transform: scaleX(0);
    transition: transform var(--transition-fast);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .desktop-cta {
    display: none;
  }

  .btn-round {
    border-radius: var(--radius-full) !important;
  }

  @media (min-width: 768px) {
    .desktop-nav,
    .desktop-cta {
      display: flex;
    }
  }

  .menu-toggle-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .menu-toggle-btn:hover {
    background-color: var(--color-brand-green-light);
  }

  @media (min-width: 768px) {
    .menu-toggle-btn {
      display: none;
    }
  }

  .burger-bar {
    width: 1.25rem;
    height: 2px;
    background-color: var(--color-slate-dark);
    margin: 2px 0;
    transition: all var(--transition-normal);
  }

  .menu-toggle-btn.is-active .bar-1 {
    transform: translateY(6px) rotate(45deg);
  }

  .menu-toggle-btn.is-active .bar-2 {
    opacity: 0;
  }

  .menu-toggle-btn.is-active .bar-3 {
    transform: translateY(-6px) rotate(-45deg);
  }

  .mobile-menu-panel {
    position: fixed;
    left: 0;
    right: 0;
    top: 5.5rem; 
    background-color: var(--color-white);
    border-b: 1px solid rgba(156, 163, 175, 0.12);
    box-shadow: var(--shadow-lg);
    padding: var(--space-6);
    display: none;
    flex-direction: column;
    gap: var(--space-4);
  }

  .mobile-menu-panel.is-open {
    display: flex;
  }

  @media (min-width: 768px) {
    .mobile-menu-panel.is-open {
      display: none;
    }
  }

  .mobile-link {
    font-family: var(--font-headers);
    font-size: var(--font-size-base);
    font-weight: var(--weight-medium);
    color: var(--color-slate-dark);
    text-decoration: none;
    padding: var(--space-2) 0;
    border-b: 1px solid rgba(156, 163, 175, 0.05);
  }

  .mobile-cta {
    border-bottom: none;
    text-align: center;
    width: 100%;
    margin-top: var(--space-2);
  }
</style>