---
// src/components/sections/AdmissionsSection.astro
import ContactForm from './ContactForm'; 
---

<section id="admisiones" class="admissions-section overflow-hidden">
  <div class="container mx-auto px-4 md:px-6">
    
    <div class="admissions-grid">
      
      <div class="admissions-info reveal-fade">
        <span class="admissions-badge">Proceso de Admisión</span>
        <h2>Inicia el camino hacia su autonomía</h2>
        
        <p class="admissions-lead">
          Sabemos que elegir la primera escuela de tu hijo es una decisión trascendental. Te invitamos a una <strong>sesión informativa personalizada</strong> donde podrás conocer nuestros ambientes y la forma de trabajo de los pequeños en su día a día.
        </p>

        <div class="contact-channels">
          <a href="tel:5530930931" class="channel-card">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.824-1.47-5.112-3.758-6.58-6.58l1.293-.97c.362-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.75Z" />
              </svg>
            </div>
            <div class="channel-details">
              <span>Casa de los niños</span>
              <strong>55 3093 0931</strong>
            </div>
          </a>

          <div class="channel-card non-clickable">
            <div class="channel-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
              </svg>
            </div>
            <div class="channel-details">
              <span>Ubicación de nuestro ambiente</span>
              <strong>Unión 272, Col. Tepeyac Insurgentes, CDMX</strong>
            </div>
          </div>
        </div>
      </div>

      <div class="admissions-form-wrapper reveal-stagger my-4 lg:my-0">
        <ContactForm client:visible />
      </div>

    </div>

  </div>
</section>

<script>
  (() => {
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal-fade, .reveal-stagger').forEach(el => observer.observe(el));
    });
  })();
</script>

<style>
  .admissions-section {
    /* Respiro exacto de 3em enmarcado que solicitaste para consistencia global */
    padding: 3em 0;
    /* Un verde pastel de marca ultra suave lavado para que actúe como fondo neutro */
    background-color: #f1f6f4; 
  }

  @media (min-width: 768px) {
    .admissions-section {
      padding: 4.5em 0;
    }
  }

  .admissions-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
    max-width: 1140px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .admissions-grid {
      /* Estructura asimétrica premium: 5 columnas texto, 7 columnas formulario */
      grid-template-columns: repeat(12, 1fr);
      gap: var(--space-16);
    }
    
    .admissions-info {
      grid-column: span 5;
    margin: 1em 0;    }
    
    .admissions-form-wrapper {
      grid-column: span 7;
    }
  }

  .admissions-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .admissions-badge {
    font-family: var(--font-headers);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-bold);
    color: var(--color-brand-green);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .admissions-info h2 {
    color: var(--color-slate-dark);
    line-height: 1.2;
    margin: 0;
  }

  .admissions-lead {
    font-size: var(--font-size-sm);
    color: var(--color-slate-dark);
    opacity: 0.85;
    line-height: 1.65;
    margin-bottom: var(--space-4);
  }

  /* --- Tarjetas de Canales de Contacto --- */
  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .channel-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    background-color: rgba(255, 255, 255, 0.6);
    padding: var(--space-4);
    border-radius: var(--radius-lg, 16px);
    border: 1px solid rgba(13, 71, 49, 0.04);
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .channel-card.non-clickable {
    cursor: default;
  }

  /* Hover interactivo sutil solo para el teléfono */
  a.channel-card:hover {
    background-color: var(--color-white);
    transform: translateX(4px);
    border-color: rgba(13, 71, 49, 0.1);
    box-shadow: 0 4px 15px rgba(13, 71, 49, 0.03);
  }

  .channel-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-white);
    color: var(--color-brand-green);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
    flex-shrink: 0;
  }

  .channel-details {
    display: flex;
    flex-direction: column;
  }

  .channel-details span {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-slate-dark);
    opacity: 0.6;
    font-weight: 600;
  }

  .channel-details strong {
    font-size: var(--font-size-sm);
    color: var(--color-slate-dark);
    line-height: 1.4;
  }

  /* --- Animaciones de Entrada --- */
  .reveal-fade, .reveal-stagger {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.8s ease-out, transform 0.8s ease-out;
  }

  .reveal-fade.is-visible, .reveal-stagger.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>