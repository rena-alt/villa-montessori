---
// src/components/sections/GallerySection.astro
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob('/src/assets/images/**/*.{jpeg,jpg,png,gif,webp}', { eager: true });

const photos = Object.keys(imageFiles).map((path) => {
  const imageModule = imageFiles[path] as any;
  const metadata = imageModule.default;

  const isLandscape = metadata.width > metadata.height;
  const isSquare = metadata.width === metadata.height;

  let aspectClass = 'aspect-[3/4]'; 
  
  if (isLandscape) {
    aspectClass = metadata.width / metadata.height > 1.5 
      ? 'md:col-span-2 aspect-[16/10]' 
      : 'md:col-span-2 aspect-[4/3]';
  } else if (isSquare) {
    aspectClass = 'aspect-square';
  }

  const fileName = path.split('/').pop()?.split('.')[0] || '';
  const cleanCaption = fileName.replace(/[-_]/g, ' ').replace(/^\w/, (c) => c.toUpperCase());

  return {
    src: path,
    meta: metadata, 
    caption: cleanCaption,
    alt: `Imagen de galería: ${cleanCaption}`,
    aspect: aspectClass
  };
});
---

<section id="galeria" class="gallery-section">
  <div class="container mx-auto px-4 md:px-8">
    
    <div class="gallery-header text-center reveal-fade">
      <span class="gallery-badge">El Ambiente Preparado</span>
      <h2>Un vistazo a nuestra Casa de los Niños</h2>
      <p class="gallery-lead">
        Cada rincón está pensado para fomentar la libertad, el respeto y el autoaprendizaje guiado.
      </p>
    </div>

    <div class="gallery-grid">
      {photos.map((photo) => (
        <div class={`gallery-item group reveal-stagger ${photo.aspect}`}>
          <div class="image-wrapper">
            <Image 
              src={photo.meta} 
              alt={photo.alt}
              loading="lazy"
              decoding="async"
            />
            <div class="photo-overlay">
              <div class="overlay-content">
                <p class="photo-caption">{photo.caption}</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  (() => {
    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -10% 0px',
      threshold: 0.1
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.reveal-fade, .reveal-stagger').forEach(el => observer.observe(el));
    });
  })();
</script>

<style>
  .gallery-section {
    padding: 6em 0;
    background-color: var(--color-bg-cream, #fdfbf7); 
  }

  .gallery-header {
    max-width: 600px;
    margin: 0 auto 4em auto;
  }

  .gallery-badge {
    font-family: var(--font-headers);
    font-size: 11px;
    font-weight: 700;
    color: var(--color-brand-green, #0d4731);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    display: block;
    margin-bottom: 1em;
  }

  .gallery-header h2 {
    color: var(--color-slate-dark, #1e293b);
    font-size: 2.5rem;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .gallery-lead {
    font-size: 1.1rem;
    color: var(--color-slate-dark, #1e293b);
    opacity: 0.8;
    line-height: 1.6;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .gallery-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-flow: dense; 
    }
  }

  .gallery-item {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 16px; 
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.02);
    background-color: rgba(13, 71, 49, 0.03); 
  }

  .image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
  }

  .gallery-item img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important; 
    display: block;
    transition: transform 0.8s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallery-item:hover img {
    transform: scale(1.03);
  }

  .photo-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(13, 71, 49, 0.75) 0%,
      rgba(13, 71, 49, 0.2) 60%,
      transparent 100%
    );
    display: flex;
    align-items: flex-end;
    padding: 24px;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .gallery-item:hover .photo-overlay {
    opacity: 1;
  }

  .overlay-content {
    transform: translateY(12px);
    transition: transform 0.4s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .gallery-item:hover .overlay-content {
    transform: translateY(0);
  }

  .photo-caption {
    color: #ffffff;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    margin: 0;
  }

  .reveal-fade, .reveal-stagger {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 1s cubic-bezier(0.25, 1, 0.5, 1), transform 1s cubic-bezier(0.25, 1, 0.5, 1);
  }

  .reveal-fade.is-visible, .reveal-stagger.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>