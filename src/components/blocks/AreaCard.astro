---
// src/components/blocks/AreaCard.astro
import { Image } from 'astro:assets';

interface Props {
  title: string;
  description: string;
  imagePath: ImageMetadata;
  imageAlt: string;
  learningFocus: string[];
}

const { title, description, imagePath, imageAlt, learningFocus } = Astro.props;
---

<div class="card area-card">
  
  <div class="image-container">
    <Image 
      src={imagePath} 
      alt={imageAlt}
      width={600}
      height={450}
      class="card-image"
    />
  </div>

  <div class="card-content">
    <h3 class="card-title">
      {title}
    </h3>
    
    <p class="card-description">
      {description}
    </p>

    <div class="focus-development">
      <span class="focus-label">
        Desarrollo Clave:
      </span>
      <ul class="focus-list">
        {learningFocus.map((item) => (
          <li class="focus-item">
            <span class="bullet"></span>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .area-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 0 !important; 
    overflow: hidden;
  }

  .image-container {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-bg-cream);
  }

  .card-image {
    object-fit: cover;
    width: 100%;
    height: 100%;
    transition: transform var(--transition-normal);
  }

  .area-card:hover .card-image {
    transform: scale(1.05);
  }

  .area-card:hover .card-title {
    color: var(--color-brand-green);
  }

  .card-content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-title {
    margin-bottom: var(--space-2) !important;
    font-size: var(--font-size-md);
    transition: color var(--transition-fast);
  }

  .card-description {
    font-size: var(--font-size-sm);
    color: var(--color-slate-dark);
    opacity: 0.9;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .focus-development {
    border-top: 1px solid rgba(156, 163, 175, 0.12);
    padding-top: var(--space-4);
    margin-top: auto;
  }

  .focus-label {
    display: block;
    margin-bottom: var(--space-2);
    font-family: var(--font-headers);
    font-size: var(--font-size-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-slate-light);
    text-transform: uppercase;
    tracking-ratio: 0.05em; 
    letter-spacing: 0.05em;
  }

  .focus-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .focus-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    color: var(--color-slate-dark);
  }

  .bullet {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: var(--color-brand-orange);
    flex-shrink: 0;
  }
</style>